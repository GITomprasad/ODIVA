# ==============================================================================
# ODIVA (ଓଡ଼ିଭା) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Hosted PostgreSQL & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. xAI API (ODIVA Sangathi AI Assistant) - Optional
# Model supported: grok-2-latest
XAI_API_KEY=your-xai-api-key

# 3. Razorpay Payments Integration - Optional (Defaults to Cash on Delivery)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# 4. App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
